+def score_proximity_energy(X, mask_generate, batch_ids, scores):
+    """Attract generated latent positions to high-scoring receptor C-alpha atoms."""
+    energy = X.new_zeros(())
+    for batch_id in torch.unique(batch_ids):
+        in_batch = batch_ids == batch_id
+        context = in_batch & ~mask_generate
+        generated = in_batch & mask_generate
+        weights = scores[context].to(dtype=X.dtype)
+        positive = weights > 0
+        if not torch.any(positive):
+            continue
+        weights = weights[positive]
+        receptor_ca = X[context, VOCAB.ca_channel_idx][positive]
+        peptide_latent = X[generated, 0]
+        distances = torch.cdist(peptide_latent, receptor_ca)
+        log_weights = weights.log()
+        soft_distance = -2.0 * (
+            torch.logsumexp(log_weights[None, :] - distances / 2.0, dim=1)
+            - torch.logsumexp(log_weights, dim=0)
+        )
+        energy = energy + (2.0 * F.softplus((soft_distance - 8.0) / 2.0)).mean()
+    return energy
+
+
+def combined_guidance_energy(model, X, mask_generate, batch_ids, scores, strength):
+    energy = model.latent_geometry_guidance(X, mask_generate, batch_ids)
+    if strength:
+        energy = energy + strength * score_proximity_energy(
+            X, mask_generate, batch_ids, scores)
+    return energy
+
+
+def peptide_coordinates_supported(blocks):
+    """Reject divergent peptide coordinates before writing a fixed-width PDB."""
+    for block in blocks:
+        for atom in block:
+            coordinate = np.asarray(atom.coordinate)
+            if (not np.isfinite(coordinate).all()
+                    or not (np.abs(coordinate) < 1000.0).all()
+                    or any(len(f'{float(value):8.3f}') > 8 for value in coordinate)):
+                return False
+    return True
+
