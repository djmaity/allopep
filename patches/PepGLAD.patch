+def relax_designs(pdb_paths, out_dir):
+    """Keep a single bad minimization from aborting the other samples."""
+    summary_path = os.path.join(out_dir, 'summary.jsonl')
+    with open(summary_path) as handle:
+        records = [json.loads(line) for line in handle if line.strip()]
+    by_id = {record['id']: record for record in records}
+    try:
+        ray.init(num_cpus=8)
+        futures = {openmm_relax.remote(path): path for path in pdb_paths}
+        with tqdm(total=len(futures)) as pbar:
+            while futures:
+                ready, _ = ray.wait(list(futures), num_returns=1)
+                for future in ready:
+                    path = futures.pop(future)
+                    try:
+                        ray.get(future)
+                    except ray.exceptions.RayTaskError as exc:
+                        # Worker loss and a broken Ray runtime are infrastructure
+                        # failures; only errors from an individual minimizer are
+                        # recoverable candidate failures.
+                        record = by_id[splitext(basename(path))[0]]
+                        record['status'] = 'error'
+                        record['error'] = f'OpenMM relaxation failed: {exc}'
+                        quarantine = os.path.join(out_dir, 'invalid_designs')
+                        os.makedirs(quarantine, exist_ok=True)
+                        if os.path.exists(path):
+                            os.replace(path, os.path.join(quarantine, basename(path)))
+                        with open(path + '.relax_error.json', 'w') as handle:
+                            json.dump({'error': record['error']}, handle)
+                        temporary = summary_path + '.tmp'
+                        with open(temporary, 'w') as handle:
+                            for row in records:
+                                handle.write(json.dumps(row) + '\n')
+                        os.replace(temporary, summary_path)
+                    pbar.update(1)
+    finally:
+        ray.shutdown()
+
