+def peptide_coordinates_supported(blocks):
+    """Reject divergent peptide coordinates before writing a fixed-width PDB."""
+    for block in blocks:
+        for atom in block:
+            coordinate = np.asarray(atom.coordinate)
+            if (not np.isfinite(coordinate).all()
+                    or not (np.abs(coordinate) < 1000.0).all()
+                    or any(len(f'{float(value):8.3f}') > 8 for value in coordinate)):
+                return False
+    return True
+
